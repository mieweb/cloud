{
  "name": "@mieweb/cloud-local",
  "version": "0.1.0",
  "description": "Local/Node adapters implementing the Cloudflare-shaped @mieweb/cloud contracts: D1→SQLite (better-sqlite3), R2→filesystem, KV→in-memory/Redis, Queues→in-process, Durable Objects→in-process registry. Vectorize/Workers AI surface explicit UnsupportedBindingError. Includes a Node host harness that runs the unchanged worker handler.",
  "type": "module",
  "license": "MIT",
  "author": "MIEWEB",
  "homepage": "https://github.com/mieweb/cloud#readme",
  "bugs": "https://github.com/mieweb/cloud/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mieweb/cloud.git",
    "directory": "packages/cloud-local"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./host": "./src/host.mjs",
    "./migrate": "./src/migrate.mjs"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@mieweb/footnote": "link:../../vendor/footnote"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0",
    "sqlite-vec": "^0.1.6"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  },
  "files": [
    "src"
  ]
}
